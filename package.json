{
  "name": "express-response-errors",
  "version": "2.0.0-beta.1",
  "description": "Collection of custom response errors and middleware for express",
  "author": {
    "name": "Dwight Rodriques",
    "email": "drodriques@gmail.com"
  },
  "main": "index.js",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "npm run build && tsc -p tests/types/tsconfig.json",
    "lint": "biome check . --error-on-warnings",
    "test": "npm run build && node --test tests/*.test.cjs",
    "test:package": "node scripts/test-package.cjs",
    "validate": "npm run lint && npm run typecheck && npm test && npm run test:package",
    "prepack": "npm run build",
    "release:check": "npm run validate && npm audit && node scripts/release.cjs --check",
    "release:prepare": "node scripts/release.cjs",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drodriques/express-response-errors.git"
  },
  "keywords": [
    "http",
    "express",
    "status",
    "code",
    "error",
    "response"
  ],
  "license": "MIT",
  "typings": "./dist/index.d.ts",
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/node": "^22.20.5",
    "@types/express": "^5.0.6",
    "express": "^5.3.0",
    "express4": "npm:express@^4.22.3",
    "supertest": "^7.3.2",
    "@biomejs/biome": "^2.6.7"
  },
  "dependencies": {},
  "type": "commonjs",
  "types": "./dist/index.d.ts",
  "files": [
    "index.js",
    "lib/",
    "types/",
    "dist/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ]
}
